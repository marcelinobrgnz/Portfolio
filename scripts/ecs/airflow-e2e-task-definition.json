{
  "family": "airflow-e2e-demo",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::864981752170:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::864981752170:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "airflow",
      "image": "apache/airflow:2.10.4-python3.11",
      "essential": true,
      "portMappings": [{"containerPort": 8080, "hostPort": 8080, "protocol": "tcp"}],
      "environment": [
        {"name": "AIRFLOW__CORE__LOAD_EXAMPLES", "value": "False"},
        {"name": "AIRFLOW__CORE__EXECUTOR", "value": "SequentialExecutor"},
        {"name": "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN", "value": "sqlite:////opt/airflow/airflow.db"},
        {"name": "S3_DAGS_URI", "value": "s3://mlops-inference-platform-864981752170/airflow-demo/dags/"}
      ],
      "command": ["bash", "-lc", "pip install --quiet awscli apache-airflow-providers-amazon && aws s3 sync $S3_DAGS_URI /opt/airflow/dags/ --region eu-west-1 && airflow db migrate && airflow users create --username admin --password admin --firstname Admin --lastname User --role Admin --email admin@example.com 2>/dev/null || true && airflow dags reserialize && airflow scheduler & exec airflow webserver"],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/airflow-e2e-demo",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
