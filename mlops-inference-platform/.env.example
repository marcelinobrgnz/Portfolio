# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=wine-quality

# Model serving
MODEL_PATH=models/wine_quality_model.pkl
MODEL_METADATA_PATH=models/model_metadata.json

# AWS (eu-west-1 Ireland) — optional for S3-backed MLflow & drift reports
AWS_DEFAULT_REGION=eu-west-1
S3_BUCKET=mlops-inference-platform-864981752170
MLFLOW_S3_ENDPOINT_URL=

# Project 2 feature store (optional — Parquet path local or s3://)
FEATURE_STORE_PATH=

# API
API_HOST=0.0.0.0
API_PORT=8000
