# full = complete CFPB dump (preferred for portfolio). sample = first N rows for speed.
CFPB_MODE=full
CFPB_SAMPLE_ROWS=200000
CFPB_CHUNKSIZE=200000
CFPB_DATA_DIR=data

# --- Optional S3 (leave blank to skip cloud upload) ---
AWS_REGION=eu-west-1
S3_BUCKET=
S3_PREFIX=cfpb/parquet

# --- Snowflake (used by scripts / docs; dbt uses profiles.yml) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=CFPB_WH
SNOWFLAKE_DATABASE=CFPB_DB
SNOWFLAKE_SCHEMA_RAW=RAW
SNOWFLAKE_SCHEMA_ANALYTICS=ANALYTICS

# Local path Snowflake stage can read from IF using local file PUT
LOCAL_PARQUET_DIR=data/parquet/complaints

# --- Databricks ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=
# 0 = upload all parquet files
DATABRICKS_MAX_FILES=0
